map_hash_bucket_size 128;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_authorization $lingma_v1_authorized {
    default 0;
    "Bearer ${LINGMA_GATEWAY_TOKEN}" 1;
}

map $http_authorization $qoder_v1_authorized {
    default 0;
    "Bearer ${LINGMA_GATEWAY_TOKEN}" 1;
}

# CPA's management UI detects only scheme/host/port as its default API base,
# so a page mounted at /cpa/ still requests the absolute /v1/models path.
# Keep that one browser request scoped by Referer while all other /v1 traffic
# retains the lingma-proxy contract.
map $http_referer $cpa_management_ui_request {
    default 0;
    ~^https?://[^/]+/cpa/ 1;
}

map "$cpa_management_ui_request:$lingma_v1_authorized" $v1_models_backend {
    default 0;
    "0:1" 127.0.0.1:8095;
    ~^1: 127.0.0.1:8317;
}

server {
    listen 80 default_server;
    server_name _;

    # Multimodal probe/chat posts base64 images in JSON; nginx default 1m returns 413.
    client_max_body_size 256m;

    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_connect_timeout 60s;

    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Added: Reverse proxy for lingma-proxy with API key check
    location /v1/ {
        # 验证 Intranet 访问的 API Key (Bearer Token)
        # Token is rendered from the untracked ops/gateway/.env at container startup.
        if ($lingma_v1_authorized = 0) {
            add_header Content-Type 'application/json' always;
            return 401 '{"error": {"message": "Invalid or missing Bearer API Token for Intranet", "type": "invalid_request_error", "code": "invalid_api_key"}}';
        }

        proxy_pass http://127.0.0.1:8095/v1/;

        # 流式 SSE 必须关闭 Nginx 缓存
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # Qoder IPC reverse proxy (lingma-proxy-qoder @8096)
    location = /qoder {
        return 301 /qoder/;
    }

    location = /qoder/ {
        return 302 /qoder/v1/models;
    }

    location /qoder/v1/ {
        if ($qoder_v1_authorized = 0) {
            add_header Content-Type 'application/json' always;
            return 401 '{"error": {"message": "Invalid or missing Bearer API Token for Intranet", "type": "invalid_request_error", "code": "invalid_api_key"}}';
        }

        proxy_pass http://127.0.0.1:8096/v1/;

        # 流式 SSE 必须关闭 Nginx 缓存
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    location = /dcc {
        return 301 /dcc/;
    }

    location /dcc/ {
        proxy_set_header Host 127.0.0.1:9999;
        proxy_set_header Origin http://127.0.0.1:9999;
        proxy_set_header Referer http://127.0.0.1:9999/;
        proxy_set_header X-Forwarded-Prefix /dcc;
        proxy_set_header Accept-Encoding "";
        proxy_redirect / /dcc/;
        sub_filter_once off;
        sub_filter_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;
        sub_filter 'href="/' 'href="/dcc/';
        sub_filter 'src="/' 'src="/dcc/';
        sub_filter '"start_url": "/"' '"start_url": "/dcc/"';
        sub_filter '"start_url":"/"' '"start_url":"/dcc/"';
        sub_filter '"src": "/' '"src": "/dcc/';
        sub_filter '"src":"/' '"src":"/dcc/';
        sub_filter '"/api/' '"/dcc/api/';
        sub_filter "'/api/" "'/dcc/api/";
        sub_filter '`/api/' '`/dcc/api/';
        sub_filter 'jsxDEV(GW,{children:' 'jsxDEV(GW,{basename:"/dcc",children:';
        sub_filter 'jsxDEV(MW,{children:' 'jsxDEV(MW,{basename:"/dcc",children:';
        sub_filter 'jsxDEV(c2,{children:' 'jsxDEV(c2,{basename:"/dcc",children:';
        proxy_pass http://127.0.0.1:9999/;
    }

    location = /tb {
        return 301 /tb/;
    }

    # Root-mounted TensorBoard behind SSH tunnel (host-recovery inventory):
    #   remote: tensorboard --logdir .../logs --host 127.0.0.1 --port 6006
    #   local:  ssh -N -T -g -L 0.0.0.0:16006:127.0.0.1:6006 luban_1_card
    # Trailing slash on proxy_pass strips /tb/ before forwarding.
    location /tb/ {
        proxy_set_header X-Forwarded-Prefix /tb;
        proxy_pass http://127.0.0.1:16006/;
    }

    # Model release tools (frontend built with Vite base=/release/).
    location = /release {
        return 301 /release/;
    }

    location /release/ {
        proxy_pass http://127.0.0.1:8765/;
    }

    # RA sim repro dashboard: static build served by nginx, API proxied to
    # the FastAPI backend. try_files falls back to the SPA shell so history
    # routes like /sim/issues survive direct open and refresh.
    location = /sim {
        return 301 /sim/;
    }

    location /sim/api/ {
        proxy_pass http://127.0.0.1:8000/api/;
    }

    location /sim/ {
        alias /usr/share/nginx/sim/;
        index index.html;
        try_files $uri $uri/ /sim/index.html;
    }

    # ------------------------------------------------------------------
    # CPA (CLI Proxy API) — experimental, may be removed at any time.
    # Delete this whole block when CPA is retired; nothing else depends
    # on it. CPA validates its own Bearer token, nginx just passes it on.
    # ------------------------------------------------------------------
    location = /cpa {
        return 301 /cpa/;
    }

    location = /cpa/ {
        return 302 /cpa/management.html#/quota;
    }

    location /cpa/v1/ {
        proxy_pass http://127.0.0.1:8317/v1/;

        # 流式 SSE 必须关闭 Nginx 缓存
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # Model discovery in the CPA management UI uses absolute /v1/models even
    # though the page is mounted below /cpa/. Requests from that page go to
    # CPA; direct clients still need the lingma token and use lingma-proxy.
    location = /v1/models {
        if ($v1_models_backend = 0) {
            add_header Content-Type 'application/json' always;
            return 401 '{"error": {"message": "Invalid or missing Bearer API Token for Intranet", "type": "invalid_request_error", "code": "invalid_api_key"}}';
        }

        proxy_pass http://$v1_models_backend;
        proxy_buffering off;
        proxy_cache off;
    }

    # The CPA management UI is not fully subpath-aware: even when served from
    # /cpa/management.html, it calls absolute /v0/management/* endpoints.
    # Keep this root-scoped compatibility route narrow so CPA remains easy to
    # remove later.
    location = /v0/management {
        proxy_pass http://127.0.0.1:8317;
    }

    location /v0/management/ {
        proxy_pass http://127.0.0.1:8317;
    }

    location /cpa/ {
        proxy_pass http://127.0.0.1:8317/;
    }
    # ------------------------- end CPA block -------------------------

    # Static tool portal home. Unknown paths get 404 from here instead of
    # leaking to any upstream.
    location / {
        root /usr/share/nginx/portal;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
